# SwasthyaEHR backend — environment configuration.
# Copy to .env for local dev, or set these in your orchestrator for deployments.

# --- SECURITY ----------------------------------------------------------------
# Required when DJANGO_DEBUG is off (the app refuses to boot without it). Generate:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Safe-by-default: off. Set to True only for local development / the demo.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Browser origins allowed to call the API with credentials (the httpOnly JWT cookie).
CORS_ALLOWED_ORIGINS=http://localhost:3090,http://127.0.0.1:3090

# JWT lifetimes.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- DATABASE ----------------------------------------------------------------
DB_NAME=swastha_db
DB_USER=nuhrs
DB_PASSWORD=nuhrs
DB_HOST=localhost
DB_PORT=5432

# --- NUHRS FEDERATION --------------------------------------------------------
NUHRS_ENABLED=True
NUHRS_PLATFORM_URL=http://localhost:8000
NUHRS_API_KEY=swastha-demo-key-0005
NUHRS_ORG_CODE=HOSP003
