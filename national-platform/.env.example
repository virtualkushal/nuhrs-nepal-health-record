# NUHRS National Platform — environment configuration.
# Copy to .env for local dev, or set these in your orchestrator for deployments.

# --- SECURITY ----------------------------------------------------------------
# Required when DEBUG is off (the app refuses to boot without it). Generate one:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Safe-by-default: off. Set to True only for local development / the demo.
DEBUG=False

# Comma-separated Host header allow-list. Include the in-cluster service name
# (national-platform) if edge services call this platform by hostname.
ALLOWED_HOSTS=localhost,127.0.0.1

# Browser origins allowed to call the API with credentials (the httpOnly JWT
# cookie). A wildcard origin is NOT permitted together with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- DATABASE ----------------------------------------------------------------
DB_NAME=national_db
DB_USER=nuhrs
DB_PASSWORD=nuhrs
DB_HOST=localhost
DB_PORT=5432

# --- INTEGRATION -------------------------------------------------------------
# Browser-facing origin of the React portal (used to build the SSO redirect).
NUHRS_PORTAL_URL=http://localhost:3000
