*.py[cod]
*.egg-info/
.eggs/
*.egg
.Python
env/
venv/
.venv/
ENV/
db.sqlite3
db.sqlite3-journal
*.log
staticfiles/
mediafiles/
media/

# Environment
.env
.env.*
!.env.example

# Node / React
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

